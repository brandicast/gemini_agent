# ========== Google Gemini API Configuration ==========
# Required: Your Google Gemini API key
# Get your API key from: https://aistudio.google.com/app/apikey
API_KEY={$YOUR_KEY}

# ========== Define the model of this agent ==========
MODEL=gemini-3.5-flash-lite
# ========== Application Configuration ==========
# Flask server host (default: 0.0.0.0 for Docker, 127.0.0.1 for local)
FLASK_HOST=0.0.0.0

# Flask server port
FLASK_PORT=5000

# Flask debug mode (set to 1 for development, 0 for production)
FLASK_DEBUG=0

# ========== CWA API Configuration ==========
# Required for Weather Plugin: Central Weather Administration (Taiwan) API Key
# Get your API key from: https://opendata.cwa.gov.tw/user/authkey
CWA_API_KEY={$CWA_API_KEY}
